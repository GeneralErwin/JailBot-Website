{
  // Deploy target for `npx wrangler deploy`, which Cloudflare Workers Builds uses
  // by default. The Worker itself is built by vinext into .cloudflare/output:
  // `npm run build` runs `cf build` after `next build`. This file only points
  // Wrangler at that output, so Wrangler never tries to auto-configure the repo
  // as an OpenNext project.
  //
  // Keep name, compatibility_date, compatibility_flags and assets in sync with
  // cloudflare.config.ts, which is the source of truth for cf deploys
  // (`npx cf deploy` / `npm run deploy:vinext`).
  //
  // Hyperdrive: if you enable HYPERDRIVE_ID and deploy through Wrangler instead
  // of the cf CLI, add a `hyperdrive` binding here as well.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jailbot-website",
  "main": ".cloudflare/output/v0/workers/default/bundle/index.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".cloudflare/output/v0/workers/default/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  "observability": {
    "enabled": true
  }
}