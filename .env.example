# Public site origin. Use https in production.
APP_URL=http://localhost:3000
NODE_ENV=development

# Discord OAuth application credentials. Redirect URI must be:
# {APP_URL}/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# PostgreSQL connection string (TLS enabled by your managed provider in production).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jailbot

# Base64-encoded 32-byte AES-256 key. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# HMAC credentials for the Rust bot integration. Generate a unique key ID and
# base64-encoded 32-byte secret. Never reuse the Discord bot token here.
BOT_API_KEY_ID=local-dev
BOT_API_SECRET=

# Optional Sentry DSN. No event is sent when unset.
SENTRY_DSN=

# Optional OpenTelemetry OTLP trace collector endpoint (for example Grafana Alloy).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
